---
import Section from "../layout/Section.astro";
import Container from "../layout/Container.astro";
---

<Section class="community-section">

  <Container>

    <header class="section-header">

      <h2>Outreach & Communication</h2>

      <p>
        Communicating mathematical and computational approaches
        to neuroscience beyond individual research publications.
      </p>

    </header>


    <div class="community-list">

      <article class="community-entry">

        <div class="community-year">
          2025
        </div>

        <div class="community-entry-content">

          <h3>From Neurons to Networks</h3>

          <p class="community-meta">
            GEOTOP Seminar
          </p>

        </div>

      </article>


      <article class="community-entry">

        <div class="community-year">
          2022–2023
        </div>

        <div class="community-entry-content">

          <h3>Science Communication</h3>

          <p class="community-meta">
            EPFL News
          </p>

          <ul class="community-sublist">
            <li>Decoding neuronal variability</li>
            <li>Building neurons with mathematics</li>
            <li>Pioneering Algebraic Topology</li>
            <li>The real neuron challenge</li>
          </ul>

        </div>

      </article>


      <article class="community-entry">

        <div class="community-year">
          2019
        </div>

        <div class="community-entry-content">

          <h3>
            A Solution to a Century-old Neuroscience Problem
          </h3>

          <p class="community-meta">
            EPFL News
          </p>

        </div>

      </article>

    </div>

  </Container>

</Section>