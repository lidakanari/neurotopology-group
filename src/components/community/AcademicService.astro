---
import Section from "../layout/Section.astro";
import Container from "../layout/Container.astro";
---

<Section class="community-section">

  <Container>

    <header class="section-header">

      <h2>Editorial & Reviewing</h2>

      <p>
        Scientific reviewing across neuroscience,
        mathematics and computational research.
      </p>

    </header>


    <div class="reviewing-layout">

      <div class="reviewing-heading">

        <span>Selected journals & conferences</span>

      </div>


      <ul class="reviewing-list">

        <li>Nature</li>

        <li>Nature Neuroscience</li>

        <li>Nature Communications</li>

        <li>Nature Biotechnology</li>

        <li>PLOS Computational Biology</li>

        <li>Journal of Mathematical Biology</li>

        <li>IEEE Transactions</li>

        <li>Research in Mathematics</li>

        <li>COSYNE</li>

      </ul>

    </div>

  </Container>

</Section>