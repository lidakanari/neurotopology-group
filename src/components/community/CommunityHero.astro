---
import Section from "../layout/Section.astro";
import Container from "../layout/Container.astro";
---

<Section class="community-hero">

  <Container>

    <div class="community-hero-text">

      <h1>Community</h1>

      <p class="community-hero-tagline">
        Connecting mathematics, neuroscience and the wider scientific community.
      </p>

      <p class="community-hero-intro">
        Outreach, scientific service and community activities
        supporting interdisciplinary research and communication.
      </p>

    </div>

  </Container>

</Section>