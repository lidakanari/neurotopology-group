---
import Section from "../layout/Section.astro";
import Container from "../layout/Container.astro";
---

<Section class="community-section community-section--alternate">

  <Container>

    <header class="section-header">

      <h2>Talks, Workshops & Conferences</h2>

      <p>
        Selected scientific talks and participation in workshops
        and conferences across mathematics and neuroscience.
      </p>

    </header>


    <div class="engagement-grid">

      <!-- Talks -->

      <article class="engagement-column">

        <div class="engagement-heading">

          <h3>Talks</h3>

        </div>

        <div class="engagement-list">

          <div class="engagement-item">
            <span>2025</span>
            <div>
              <strong>AI Erlangen — TDA Seminar</strong>
              <p>
                From Neurons to Networks: Understanding the Brain
                through Algebraic Topology
              </p>
            </div>
          </div>

          <div class="engagement-item">
            <span>2025</span>
            <div>
              <strong>Queen Mary University of London</strong>
              <p>
                From Neurons to Complex Human Networks Using
                Algebraic Topology
              </p>
            </div>
          </div>

          <div class="engagement-item">
            <span>2024</span>
            <div>
              <strong>University of Oxford</strong>
              <p>
                From Single Neurons to Complex Human Networks
                Using Algebraic Topology
              </p>
            </div>
          </div>

          <div class="engagement-item">
            <span>2023</span>
            <div>
              <strong>ICERM</strong>
              <p>
                From Single Neurons to Complex Networks Using
                Algebraic Topology
              </p>
            </div>
          </div>

        </div>

      </article>


      <!-- Workshops -->

      <article class="engagement-column">

        <div class="engagement-heading">

          <h3>Workshops</h3>

        </div>

        <div class="engagement-list">

          <div class="engagement-item">
            <span>2025</span>
            <div>
              <strong>CNS Tutorial</strong>
              <p>
                Open Brain Institute: From Single Neurons
                to Complex Networks
              </p>
            </div>
          </div>

          <div class="engagement-item">
            <span>2023</span>
            <div>
              <strong>Topology and Geometry in Neuroscience</strong>
              <p>
                ICERM · Providence
              </p>
            </div>
          </div>

          <div class="engagement-item">
            <span>2022</span>
            <div>
              <strong>Math Neuro Workshop</strong>
              <p>
                Algebraic Topology Insights on Mouse and Human
                Neuronal Morphologies
              </p>
            </div>
          </div>

          <div class="engagement-item">
            <span>2021</span>
            <div>
              <strong>MSRI Hot Topics</strong>
              <p>
                Topological Insights in Neuroscience
              </p>
            </div>
          </div>

        </div>

      </article>


      <!-- Conferences -->

      <article class="engagement-column">

        <div class="engagement-heading">

          <h3>Conferences</h3>

        </div>

        <div class="engagement-list">

          <div class="engagement-item">
            <span>2025</span>
            <div>
              <strong>BrainNet</strong>
              <p>Stockholm, Sweden</p>
            </div>
          </div>

          <div class="engagement-item">
            <span>2023</span>
            <div>
              <strong>Women in Computational Topology</strong>
              <p>Persistence Homology Transform</p>
            </div>
          </div>

          <div class="engagement-item">
            <span>2020</span>
            <div>
              <strong>NeurIPS — TDA and Beyond</strong>
              <p>Topological Insights on Neuronal Morphologies</p>
            </div>
          </div>

          <div class="engagement-item">
            <span>2020</span>
            <div>
              <strong>COSYNE</strong>
              <p>Topological Synthesis</p>
            </div>
          </div>

        </div>

      </article>

    </div>

  </Container>

</Section>