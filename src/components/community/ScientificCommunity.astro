---
import Section from "../layout/Section.astro";
import Container from "../layout/Container.astro";
---

<Section class="community-section community-section--alternate">

  <Container>

    <header class="section-header">

      <h2>Scientific Community</h2>

      <p>
        Participation in interdisciplinary scientific networks
        and research communities.
      </p>

    </header>


    <div class="community-role-grid">

      <article class="community-role">

        <span class="community-role-year">
          2026–now
        </span>

        <h3>
          <a
            href="https://yacadeuro.org/about/"
            target="_blank"
            rel="noopener noreferrer"
          >
            Young Academy of Europe
          </a>
        </h3>

        <p class="community-role-type">
          Fellow
        </p>

      </article>


      <article class="community-role">

        <span class="community-role-year">
          2023–now
        </span>

        <h3>
          <a
            href="https://awm-math.org/research-networks/wincomptop/"
            target="_blank"
            rel="noopener noreferrer"
          >
            Women in Computational Topology
          </a>
        </h3>

        <p class="community-role-type">
          Member
        </p>

      </article>


      <article class="community-role">

        <span class="community-role-year">
          2026–now
        </span>

        <h3>
          <a
            href="https://encode.pillar.vc/"
            target="_blank"
            rel="noopener noreferrer"
          >
            ENCODE AI for Science
          </a>
        </h3>

        <p class="community-role-type">
          <a
            href="https://encode-challengescape.pillar.vc/"
            target="_blank"
            rel="noopener noreferrer"
          >
          Brain disease research Challenge
          </a>
        </p>

      </article>


      <article class="community-role">

        <span class="community-role-year">
          2026–now
        </span>

        <h3>
          <a
            href="https://link.springer.com/journal/40708"
            target="_blank"
            rel="noopener noreferrer"
          >
            Brain Informatics
          </a>
        </h3>

        <p class="community-role-type">
          <a
            href="https://link.springer.com/journal/40708/editorial-board"
            target="_blank"
            rel="noopener noreferrer"
          >
          Associate Editor · Springer Nature
          </a>
        </p>

      </article>

    </div>

  </Container>

</Section>