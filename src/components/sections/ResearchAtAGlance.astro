---
import Container from "../layout/Container.astro";
import Section from "../layout/Section.astro";
---

<Section>

  <Container>

    <header class="section-header">

      <h2>Research at a Glance</h2>

      <p>
        Four complementary directions shape our research.
      </p>

    </header>

<div class="glance-grid">

  <a
    href="/research#mathematical-foundations"
    class="glance-card glance-card--mathematics"
  >
    <h3>Mathematical Foundations</h3>

    <p>
      Topology, geometry and stochastic structure.
    </p>
  </a>


  <a
    href="/research#data-centric-computation"
    class="glance-card glance-card--computation"
  >
    <h3>Data-Centric Computation</h3>

    <p>
      Machine learning, graph methods and multimodal biological data.
    </p>
  </a>


  <a
    href="/research#generative-biology"
    class="glance-card glance-card--generative"
  >
    <h3>Generative Biology</h3>

    <p>
      Computational synthesis, generative morphology and
      structure–function constraints.
    </p>
  </a>


  <a
    href="/research#from-cells-to-systems"
    class="glance-card glance-card--systems"
  >
    <h3>From Cells to Systems</h3>

    <p>
      Neuronal networks, connectomes and tissue organisation.
    </p>
  </a>

</div>

  </Container>

</Section>