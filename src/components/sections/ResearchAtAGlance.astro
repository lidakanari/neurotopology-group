---
import Container from "../layout/Container.astro";
import Section from "../layout/Section.astro";
---

<Section>

  <Container>

    <header class="section-header">

      <h2>Research at a Glance</h2>

      <p>
        Explore the NeuroTopology Group.
      </p>

    </header>

    <div class="glance-grid">

  <article class="glance-card accent-group">
    <h3>Group</h3>
    <p>Meet the people behind NeuroTopology.</p>
  </article>

  <article class="glance-card accent-research">
    <h3>Research</h3>
    <p>Topology of neuronal structure.</p>
  </article>

  <article class="glance-card accent-computation">
    <h3>Computation</h3>
    <p>Computational neuroscience and AI.</p>
  </article>

  <article class="glance-card accent-teaching">
    <h3>Teaching</h3>
    <p>Courses, mentoring and supervision.</p>
  </article>

  <article class="glance-card accent-community">
    <h3>Community</h3>
    <p>Open science, talks and professional service.</p>
  </article>

</div>

  </Container>

</Section>