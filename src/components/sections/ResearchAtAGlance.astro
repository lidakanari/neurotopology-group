---
import Container from "../layout/Container.astro";
import Section from "../layout/Section.astro";
---

<Section>

  <Container>

    <h2>Research at a Glance</h2>

    <div class="glance-grid">

      <article class="glance-card people">
        <h3>Group</h3>
        <p>Meet the people behind NeuroTopology.</p>
      </article>

      <article class="glance-card research">
        <h3>Research</h3>
        <p>Topology and geometry of neuronal structure.</p>
      </article>

      <article class="glance-card computation">
        <h3>Computation</h3>
        <p>Computational neuroscience and AI.</p>
      </article>

      <article class="glance-card teaching">
        <h3>Teaching</h3>
        <p>Courses, mentoring and supervision.</p>
      </article>

      <article class="glance-card community">
        <h3>Community</h3>
        <p>Open science, talks and professional service.</p>
      </article>

    </div>

  </Container>

</Section>