---
import Section from "../layout/Section.astro";
import Container from "../layout/Container.astro";

import { sitePath } from "../../lib/paths";
---

<Section>

  <Container>

    <header class="section-header">

      <h2>Featured Projects</h2>

      <p>
        Selected projects illustrating the research directions of NeuroTopology.
      </p>

    </header>


    <div class="project-grid">

      <!-- Mathematical Foundations -->

      <article class="project-card">

        <div class="project-image">
  <img
    src={sitePath("/images/projects/topology.png")}
    alt="Topological representation of branching tree structures"
  />

        </div>

        <div class="project-content">

          <span class="project-tag">
            Mathematical Foundations
          </span>

          <h3>Topology of Trees</h3>

          <p>
            Developing the mathematical framework for representing
            trees, branching structures and their topological properties.
          </p>

          <a href={sitePath("/research#mathematical-foundations")}>
            Explore project →
          </a>

        </div>

      </article>


      <!-- Data-Centric Computation -->

      <article class="project-card">

        <div class="project-image">
  <img
    src={sitePath("/images/projects/Data.png")}
    alt="Reconstructed human neurons connecting in the cortex."
  />
        </div>

        <div class="project-content">

          <span class="project-tag">
            Data-Centric Computation
          </span>

          <h3>Learning Biological Structure</h3>

          <p>
            Topological and machine learning methods for comparing,
            classifying and clustering complex cellular morphologies.
          </p>

          <a href={sitePath("/research#data-centric-computation")}>
            Explore project →
          </a>

        </div>

      </article>


      <!-- From Cells to Systems -->

      <article class="project-card">

        <div class="project-image">
  <img
    src={sitePath("/images/projects/systems.png")}
    alt="A computationally generated brain at single cell resolution."
  />
        </div>

        <div class="project-content">

          <span class="project-tag">
            From Cells to Systems
          </span>

          <h3>From Neurons to Networks</h3>

          <p>
            Understanding how single cell morphology constrains
            connectivity and contributes to brain-network organization.
          </p>

          <a href={sitePath("/research#from-cells-to-systems")}>
            Explore project →
          </a>

        </div>

      </article>

    </div>

  </Container>

</Section>