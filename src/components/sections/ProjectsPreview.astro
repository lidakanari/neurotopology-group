---
import Section from "../layout/Section.astro";
import Container from "../layout/Container.astro";
---

<Section>

  <Container>

    <header class="section-header">

      <h2>Featured Projects</h2>

      <p>
        Selected projects illustrating the research directions of NeuroTopology.
      </p>

    </header>


    <div class="project-grid">

      <!-- Mathematical Foundations -->

      <article class="project-card">

        <div class="project-image">
  <img
    src="/images/projects/topology-of-trees.svg"
    alt="Topological representation of branching tree structures"
  />

        </div>

        <div class="project-content">

          <span class="project-tag">
            Mathematical Foundations
          </span>

          <h3>Topology of Trees</h3>

          <p>
            Developing mathematical frameworks for representing
            trees, branching structures and their persistent topology.
          </p>

          <a href="/research#mathematical-foundations">
            Explore project →
          </a>

        </div>

      </article>


      <!-- Data-Centric Computation -->

      <article class="project-card">

        <div class="project-image">
  <img
    src="/images/projects/topology-of-trees.svg"
    alt="Topological representation of branching tree structures"
  />
        </div>

        <div class="project-content">

          <span class="project-tag">
            Data-Centric Computation
          </span>

          <h3>Learning Biological Structure</h3>

          <p>
            Topological and graph-based methods for comparing,
            classifying and learning from complex cellular morphologies.
          </p>

          <a href="/research#data-centric-computation">
            Explore project →
          </a>

        </div>

      </article>


      <!-- From Cells to Systems -->

      <article class="project-card">

        <div class="project-image">
  <img
    src="/images/projects/topology-of-trees.svg"
    alt="Topological representation of branching tree structures"
  />
        </div>

        <div class="project-content">

          <span class="project-tag">
            From Cells to Systems
          </span>

          <h3>From Neurons to Networks</h3>

          <p>
            Understanding how cellular morphology constrains
            connectivity and contributes to brain-network organization.
          </p>

          <a href="/research#from-cells-to-systems">
            Explore project →
          </a>

        </div>

      </article>

    </div>

  </Container>

</Section>