---
import Section from "../layout/Section.astro";
import Container from "../layout/Container.astro";
---

<Section>

  <Container>

    <header class="section-header">

      <h2>Featured Projects</h2>

      <p>
        Discover the research projects driving the NeuroTopology Group.
      </p>

    </header>

<div class="project-grid">

  <article class="project-card">

    <div class="project-image">
      <!-- Image -->
    </div>

    <div class="project-content">

      <span class="project-tag">
        Mathematical Foundations
      </span>

      <h3>Topology of Trees</h3>

      <p>
        Developing the topological framework for trees,
        branching structures and persistence barcodes.
      </p>

      <a href="/projects/topology-of-trees">
        Explore project →
      </a>

    </div>

  </article>

  <article class="project-card">

    <div class="project-image">
      <!-- Image -->
    </div>

    <div class="project-content">

      <span class="project-tag">
        Morphological Analysis
      </span>

      <h3>Topological Morphology Descriptor</h3>

      <p>
        Mathematical descriptors encoding neuronal and microglia morphology 
        across scales, species and pathological conditions.
      </p>

      <a href="/projects/topological-morphology-descriptor">
        Explore project →
      </a>

    </div>

  </article>

  <article class="project-card">

    <div class="project-image">
      <!-- Image -->
    </div>

    <div class="project-content">

      <span class="project-tag">
        Brain Connectivity
      </span>

      <h3>From Neurons to Networks</h3>

      <p>
        Bridging single-neuron morphology and whole-brain connectivity
        through computational modeling.
      </p>

      <a href="/projects/neurons-to-networks">
        Explore project →
      </a>

    </div>

  </article>

</div>

  </Container>

</Section>