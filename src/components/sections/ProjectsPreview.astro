---
import Section from "../layout/Section.astro";
import Container from "../layout/Container.astro";
---

<Section>

  <Container>

    <header class="section-header">

      <h2>Featured Projects</h2>

      <p>
        Discover the research projects driving the NeuroTopology Group.
      </p>

    </header>

    <div class="project-grid">

      <article class="project-card">

        <div class="project-image"></div>

        <h3>Topology of Neuronal Morphology</h3>

        <p>
          Mathematical representations of branching neuronal structures.
        </p>

      </article>

      <article class="project-card">

        <div class="project-image"></div>

        <h3>Computational Synthesis</h3>

        <p>
          Building biologically realistic neuronal morphologies.
        </p>

      </article>

      <article class="project-card">

        <div class="project-image"></div>

        <h3>Neurons to Networks</h3>

        <p>
          Bridging single-neuron structure and brain connectivity.
        </p>

      </article>

    </div>

  </Container>

</Section>