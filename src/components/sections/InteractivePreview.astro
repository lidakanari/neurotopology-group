---
import Section from "../layout/Section.astro";
import Container from "../layout/Container.astro";
---

<Section>

  <Container>

<header class="section-header">

  <h2>Interactive Exploration</h2>

  <p>
    Experience NeuroTopology through interactive scientific tools and educational explorations.
  </p>

</header>

<div class="interactive-grid">

  <article class="interactive-card">

    <div class="interactive-image"></div>

    <h3>Real Neuron Challenge</h3>

    <p>
      Can you distinguish real neurons from synthetic ones?
    </p>

    <p><strong>Coming soon.</strong></p>

  </article>

  <article class="interactive-card">

    <div class="interactive-image"></div>

    <h3>Synthesize Your Own Neuron</h3>

    <p>
      Explore how branching rules generate realistic neuronal morphologies.
    </p>

    <p><strong>Coming soon.</strong></p>

  </article>

</div>

  </Container>

</Section>
