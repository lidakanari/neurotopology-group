---
import Section from "../layout/Section.astro";
import Container from "../layout/Container.astro";

import { sitePath } from "../../lib/paths";
---

<Section class="interactive-preview">

  <Container>

    <header class="section-header">

      <h2>Interactive Exploration</h2>

      <p>
        Explore the work of the NeuroTopology group through interactive scientific
        games and experimentation with the tools we develop.
      </p>

    </header>


    <div class="interactive-grid">

      <!-- Real Neuron Challenge -->

      <article class="interactive-card">

        <div class="interactive-card-image">

          <img
            src={sitePath("/images/interactive/Exploration1.png")}
            alt="Neuronal morphology for the Real Neuron Challenge"
          />

        </div>


        <div class="interactive-card-content">

          <h4>
            Coming soon! 
          </h4>

          <h3>
            Real Neuron Challenge
          </h3>

          <p>
            Can you distinguish real neuronal morphologies
            from computationally generated ones?
          </p>

        </div>

      </article>


      <!-- Synthesize Your Own Neuron -->

      <article class="interactive-card">

        <div class="interactive-card-image">

          <img
            src={sitePath("/images/interactive/Exploration2.png")}
            alt="Progressive generation of a branching neuronal morphology"
          />

        </div>


        <div class="interactive-card-content">

          <h4>
            Coming soon! 
          </h4>

          <h3>
            Synthesize Your Own Neuron
          </h3>

          <p>
            Explore how mathematical and biological constraints
            generate realistic neuronal morphologies.
          </p>

        </div>

      </article>

    </div>

  </Container>

</Section>