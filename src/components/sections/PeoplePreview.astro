---
import Section from "../layout/Section.astro";
import Container from "../layout/Container.astro";

import { people } from "../../lib/people";
import { sitePath } from "../../lib/paths";

const currentPeople = people.filter(
  (person) => person.current
);
---

<Section class="people-preview">

  <Container>

    <header class="section-header">

      <h2>The People Behind NeuroTopology</h2>

      <p>
        Meet the researchers developing mathematical and computational foundations of the NeuroTopology Group.
      </p>

    </header>


    <div class="people-grid">

      {
        currentPeople.map((person) => (

          <article class="person-card">

            <div class="person-card-photo">

              {
                person.photo && (
                  <img
                    src={sitePath(person.photo)}
                    alt={person.name}
                  />
                )
              }

            </div>


            <div class="person-card-content">

              <h3>{person.name}</h3>

              <p class="person-role">
                {person.role}
              </p>

            </div>

          </article>

        ))
      }

    </div>


    <div class="people-preview-link">

      <a
        href={sitePath("/people")}
        class="section-link"
      >
        Meet the group →
      </a>

    </div>

  </Container>

</Section>