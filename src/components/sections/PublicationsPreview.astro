---
import Section from "../layout/Section.astro";
import Container from "../layout/Container.astro";
---

<Section>

  <Container>

    <header class="section-header">

      <h2>Featured Publications</h2>

      <p>
        Selected papers illustrating the research directions of NeuroTopology.
      </p>

    </header>


    <div class="publication-grid">

      <!-- Mathematical Foundations / Development -->

      <article class="publication-card">

        <div class="publication-year">
          2026
        </div>

        <h3>
          <a       
      href="https://link.springer.com/article/10.1007/s12021-026-09795-0"
      target="_blank"
      rel="noopener noreferrer"
	   >
            Temporal Topology Provides an Interpretable Framework
            for Neuronal Morphogenesis
          </a>
        </h3>

        <p>
          Neuroinformatics
        </p>

      </article>


      <!-- From Cells to Systems -->

      <article class="publication-card">

        <div class="publication-year">
          2026
        </div>

        <h3>
          <a       
      href="https://www.sciencedirect.com/science/article/pii/S2589004226015191"
      target="_blank"
      rel="noopener noreferrer"
	   >
            Spatial Continuity of Neurons Explains Non-random
            Network Architecture
          </a>
        </h3>

        <p>
          iScience
        </p>

      </article>


      <!-- Generative Biology -->

      <article class="publication-card">

        <div class="publication-year">
          2025
        </div>

        <h3>
          <a       
      href="https://www.sciencedirect.com/science/article/pii/S2589004225011897"
      target="_blank"
      rel="noopener noreferrer"
	   >
	Of mice and men: Dendritic architecture differentiates human from mouse neuronal networks          
        </a>
        </h3>

        <p>
          iScience
        </p>

      </article>

    </div>


    <a
      href="/publications"
      class="section-link"
    >
<p class="section-link">
  View all publications →
</p>
    </a>



  </Container>

</Section>