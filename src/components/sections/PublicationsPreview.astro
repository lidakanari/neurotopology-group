---
import Section from "../layout/Section.astro";
import Container from "../layout/Container.astro";
---

<Section>

  <Container>

    <header class="section-header">

      <h2>Featured Publications</h2>

      <p>
        Selected papers demonstrating the NeuroTopology Group's research.
      </p>

    </header>

    <div class="publication-grid">

      <article class="publication-card">

        <div class="publication-year">2025</div>

        <h3>Generating Brain-wide Connectomes using Synthetic Axonal Morphologies</h3>

        <p>
          Nature Communications
        </p>

      </article>

      <article class="publication-card">

        <div class="publication-year">2025</div>

        <h3>Of Mice and Men: Dendritic Architecture Differentiates Human from Mouse Neuronal Networks</h3>

        <p>
          iScience
        </p>

      </article>

      <article class="publication-card">

        <div class="publication-year">2022</div>

        <h3>Computational Synthesis of Cortical Dendritic Morphologies</h3>

        <p>
          Cell Reports
        </p>

      </article>

    </div>

    <p class="section-link">

      View all publications →

    </p>

  </Container>

</Section>