---
import { SITE } from "../../config/site";
import Container from "../layout/Container.astro";
import Section from "../layout/Section.astro";
---

<Section>

  <Container>

	<div class="hero-content">

	    <h1>{SITE.title}</h1>

	    <p class="hero-subtitle">
	      {SITE.subtitle}
	    </p>

	    <p class="hero-tagline">
	      {SITE.tagline}
	    </p>

	    <p class="hero-intro">
	      	We develop mathematical, computational and topological methods
	      	to understand how neuronal structure gives rise to brain organization.
	    </p>

	</div>

  </Container>

</Section>