---
import { SITE } from "../../config/site";
import Container from "../layout/Container.astro";
import Section from "../layout/Section.astro";

import { sitePath } from "../../lib/paths";
---

<Section class="hero">

  <Container>

    <div class="hero-layout">

      <div class="hero-text">

        <h1>{SITE.title}</h1>

        <p class="hero-subtitle">
          {SITE.subtitle}
        </p>

        <p class="hero-tagline">
          Developing mathematical foundations for understanding biological
          structure across scales.
        </p>

        <p class="hero-intro">
          We combine mathematics, topology and computation to understand
          how the structure of cells gives rise to complex biological
          organization, from individual neurons to networks.
        </p>

        <a
          href={sitePath("/research")}
          class="hero-button"
        >
          Explore Research →
        </a>

      </div>


      <div class="hero-visual">

        <img
          src={sitePath("/images/hero_neuron.svg")}
          alt="Reconstructed neuronal morphology"
        />

      </div>

    </div>

  </Container>

</Section>