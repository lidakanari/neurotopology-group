---
import { SITE } from "../../config/site";
import Container from "../layout/Container.astro";
import Section from "../layout/Section.astro";
---

<Section class="hero">

  <Container>

    <div class="hero-layout">

      <div class="hero-text">

        <h1>{SITE.title}</h1>

        <p class="hero-subtitle">
          {SITE.subtitle}
        </p>

        <p class="hero-tagline">
          {SITE.tagline}
        </p>

        <p class="hero-intro">
          We develop mathematical, computational and topological methods
          to understand how neuronal structure gives rise to brain organization.
        </p>

        <a href="/research" class="hero-button">
          Explore Research →
        </a>

      </div>

      <div class="hero-visual">

        <img
          src="/images/hero_neuron.svg"
          alt="Reconstructed neuronal morphology"
        />

      </div>

    </div>

  </Container>

</Section>