---
import Container from "../layout/Container.astro";
import { SITE } from "../../config/site";
---

<nav>

  <Container>

    <ul class="navigation">

      {
        SITE.navigation.map((item) => (

          <li>

            <a href={item.href}>{item.title}</a>

          </li>

        ))
      }

    </ul>

  </Container>

</nav>