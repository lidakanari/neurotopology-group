---
import Container from "../layout/Container.astro";
import { SITE } from "../../config/site";
---

<nav class="site-navigation">

  <Container>

    <div class="navigation-wrapper">

      <a href="/" class="site-title">

	{SITE.navigationTitle}

      </a>

      <ul class="navigation">

        {
          SITE.navigation
            .filter((item) => item.title !== "Home")
            .map((item) => (

              <li>

                <a href={item.href}>

                  {item.title}

                </a>

              </li>

            ))
        }

      </ul>

    </div>

  </Container>

</nav>