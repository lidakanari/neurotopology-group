---
import Container from "../layout/Container.astro";
import { SITE } from "../../config/site";

import { sitePath } from "../../lib/paths";
---

<nav class="site-navigation">

  <Container>

    <div class="navigation-wrapper">

      <a
        href={sitePath("/")}
        class="site-title"
      >
        {SITE.navigationTitle}
      </a>


      <!-- Desktop navigation -->

      <ul class="navigation">

        {
          SITE.navigation
            .filter((item) => item.title !== "Home")
            .map((item) => (

              <li>

                <a href={sitePath(item.href)}>
                  {item.title}
                </a>

              </li>

            ))
        }

      </ul>


      <!-- Tablet / mobile menu -->

      <details class="navigation-mobile">

        <summary>
          Menu
        </summary>

        <ul>

          {
            SITE.navigation
              .filter((item) => item.title !== "Home")
              .map((item) => (

                <li>

                  <a href={sitePath(item.href)}>
                    {item.title}
                  </a>

                </li>

              ))
          }

        </ul>

      </details>

    </div>

  </Container>

</nav>