---
import Section from "../layout/Section.astro";
import Container from "../layout/Container.astro";
---

<Section class="data-hero">

  <Container>

    <div class="data-hero-text">

      <h1>Research Data</h1>

      <p class="data-hero-tagline">
        Open datasets supporting quantitative
        research on neuronal structure.
      </p>

      <p class="data-hero-intro">
        Curated research data associated with our work
        in topology, neuronal morphology, classification
        and computational synthesis.
      </p>

    </div>

  </Container>

</Section>