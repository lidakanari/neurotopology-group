---
import type {
  ResearchDataset
} from "../../lib/datasets";

import {
  getPublicationByKey
} from "../../lib/publications";


interface Props {
  dataset: ResearchDataset;
}


const { dataset } = Astro.props;


const publication = dataset.publication
  ? getPublicationByKey(dataset.publication)
  : undefined;


const authors = dataset.authors.join(", ");
---

<article
  class="dataset-entry"
  id={dataset.id}
>

  <div class="dataset-main">

    <div class="dataset-heading">

      <span class="dataset-year">
        {dataset.year}
      </span>

      <h3>{dataset.name}</h3>

    </div>


    <p class="dataset-authors">
      {authors}
    </p>


    {
      dataset.description && (

        <p class="dataset-description">
          {dataset.description}
        </p>

      )
    }


    {
      publication && (

        <div class="dataset-publication">

          <span>
            Associated publication
          </span>

          <a
            href={`/publications#${publication.key}`}
          >
            {publication.title} →
          </a>

        </div>

      )
    }

  </div>


  <div class="dataset-meta">

    <div class="dataset-tags">

      <span class="dataset-tag">
        {dataset.repository}
      </span>

      {
        dataset.version && (

          <span class="dataset-tag">
            v{dataset.version}
          </span>

        )
      }

    </div>


    <div class="dataset-links">

      <a
        href={dataset.url}
        target="_blank"
        rel="noopener noreferrer"
      >
        View dataset ↗
      </a>

      {
        dataset.doi && (

          <a
            href={`https://doi.org/${dataset.doi}`}
            target="_blank"
            rel="noopener noreferrer"
          >
            DOI ↗
          </a>

        )
      }

    </div>

  </div>

</article>