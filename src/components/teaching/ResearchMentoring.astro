---
import Section from "../layout/Section.astro";
import Container from "../layout/Container.astro";
---

<Section class="teaching-section teaching-section--alternate">

  <Container>

    <header class="section-header">

      <h2>Research Mentoring</h2>

      <p>
        Mentoring of researchers and research software engineers
        across computational neuroscience projects.
      </p>

    </header>


    <div class="mentoring-list">


      <article class="mentoring-entry">

        <div class="mentoring-years">
          2023–2025
        </div>

        <div>

          <h3>Modeling of Dendritic Electrophysiology</h3>

          <p class="mentoring-people">
            Darshan Mandge · Anil Tuncel · Ilkan Kilic · Aurelien Jaquier
          </p>

          <p class="mentoring-role">
            Software Engineers · EPFL
          </p>

        </div>

      </article>


      <article class="mentoring-entry">

        <div class="mentoring-years">
          2020–2025
        </div>

        <div>

          <h3>Axon Synthesis</h3>

          <p class="mentoring-people">
            Adrien Berchet · Remy Petkantchin · Valerii Souchoroukov
          </p>

          <p class="mentoring-role">
            Postdoctoral Researchers · EPFL
          </p>

        </div>

      </article>


      <article class="mentoring-entry">

        <div class="mentoring-years">
          2019–2025
        </div>

        <div>

          <h3>Neuronal Reconstructions</h3>

          <p class="mentoring-people">
            Ying Shi
          </p>

          <p class="mentoring-role">
            Reconstruction Specialist · EPFL
          </p>

        </div>

      </article>


      <article class="mentoring-entry">

        <div class="mentoring-years">
          2019–2025
        </div>

        <div>

          <h3>Morpho-electrical Properties of Neurons</h3>

          <p class="mentoring-people">
            Alexis Arnaudon
          </p>

          <p class="mentoring-role">
            Postdoctoral Researcher · EPFL
          </p>

        </div>

      </article>


      <article class="mentoring-entry">

        <div class="mentoring-years">
          2019–2022
        </div>

        <div>

          <h3>Machine Learning of Neuronal Morphologies</h3>

          <p class="mentoring-people">
            Stanislav Schmidt
          </p>

          <p class="mentoring-role">
            Software Engineer · EPFL
          </p>

        </div>

      </article>


    </div>

  </Container>

</Section>