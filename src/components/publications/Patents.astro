          <h3>
            Synthesis of Branching Morphologies
          </h3>

          <p class="patent-inventors">
            Lida Kanari · Kathryn Hess Bellwald · Henry Markram
          </p>

        </div>

	 <div class="patent-meta">

	  <span>Patent application</span>

	  <p>
    	  <a
      	  href="https://patentimages.storage.googleapis.com/98/48/6b/dad486c7e7b0a8/US20220414436A1.pdf"
      	  target="_blank"
      	  rel="noopener noreferrer"
    	  >
     	  20190100470 ↗

    	 </a>
 	 </p>

	</div>

      </article>

    </div>

