---
import Section from "../layout/Section.astro";
import Container from "../layout/Container.astro";
---

<Section class="people-section people-section--soft">

  <Container>

    <header class="section-header">

      <h2>Current Members</h2>

      <p>
        Researchers and students working across the group's
        mathematical and computational research programme.
      </p>

    </header>

    <div class="people-grid">

      <article class="person-card">

        <div class="person-card-photo">
          <!-- Portrait -->
        </div>

        <div class="person-card-content">

          <h3>Member Name</h3>

          <p class="person-role">
            Postdoctoral Researcher
          </p>

          <p class="person-description">
            Short description of research interests and current work.
          </p>

          <a href="#" class="person-link">
            Profile →
          </a>

        </div>

      </article>


      <article class="person-card">

        <div class="person-card-photo">
          <!-- Portrait -->
        </div>

        <div class="person-card-content">

          <h3>Member Name</h3>

          <p class="person-role">
            Doctoral Researcher
          </p>

          <p class="person-description">
            Short description of research interests and current work.
          </p>

          <a href="#" class="person-link">
            Profile →
          </a>

        </div>

      </article>


      <article class="person-card">

        <div class="person-card-photo">
          <!-- Portrait -->
        </div>

        <div class="person-card-content">

          <h3>Member Name</h3>

          <p class="person-role">
            Research Assistant
          </p>

          <p class="person-description">
            Short description of research interests and current work.
          </p>

          <a href="#" class="person-link">
            Profile →
          </a>

        </div>

      </article>

    </div>

  </Container>

</Section>