---
import Section from "../layout/Section.astro";
import Container from "../layout/Container.astro";

import { people } from "../../lib/people";

/*
 * Current members, excluding the group lead.
 */
const members = people.filter(
  (person) =>
    person.current &&
    !person.groupLead
);
---

<Section class="people-section people-section--soft">

  <Container>

    <header class="section-header">

      <h2>Current Members</h2>

      <p>
        Researchers and students working across the group's
        mathematical and computational research programme.
      </p>

    </header>


    <div class="people-grid">

      {
        members.map((person) => (

          <article class="person-card">

            <div class="person-card-photo">

              {
                person.photo && (
                  <img
                    src={person.photo}
                    alt={person.name}
                  />
                )
              }

            </div>


            <div class="person-card-content">

              <h3>{person.name}</h3>


              <p class="person-role">
                {person.role}
              </p>


              {
                person.institution && (

                  <p class="person-affiliation">
                    {person.institution}
                  </p>

                )
              }


              {
                person.description && (

                  <p class="person-description">
                    {person.description}
                  </p>

                )
              }


              {
                person.cv && (

                  <a
                    href={`/people/${person.id}`}
                    class="person-link"
                  >
                    View CV →
                  </a>

                )
              }

            </div>

          </article>

        ))
      }

    </div>

  </Container>

</Section>