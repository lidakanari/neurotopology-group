---
import Section from "../layout/Section.astro";
import Container from "../layout/Container.astro";
---

<Section class="people-section">

  <Container>

    <header class="section-header">

      <h2>Alumni</h2>

      <p>
        Former researchers and students who have contributed
        to the group's research programme.
      </p>

    </header>

    <div class="alumni-list">

      <article class="alumni-entry">

        <div>
          <h3>Alumni Name</h3>

          <p class="alumni-role">
            Postdoctoral Researcher
          </p>
        </div>

        <div class="alumni-details">

          <p>
            Neuronal morphology and computational modelling
          </p>

          <p class="alumni-current">
            Current position
          </p>

        </div>

      </article>


      <article class="alumni-entry">

        <div>
          <h3>Alumni Name</h3>

          <p class="alumni-role">
            Research Software Engineer
          </p>
        </div>

        <div class="alumni-details">

          <p>
            Topological analysis of neuronal morphology
          </p>

          <p class="alumni-current">
            Current position
          </p>

        </div>

      </article>


      <article class="alumni-entry">

        <div>
          <h3>Alumni Name</h3>

          <p class="alumni-role">
            Master's Student
          </p>
        </div>

        <div class="alumni-details">

          <p>
            Mathematical and computational neuroscience
          </p>

          <p class="alumni-current">
            Current position
          </p>

        </div>

      </article>

    </div>

  </Container>

</Section>