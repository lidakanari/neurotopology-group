---
import Section from "../layout/Section.astro";
import Container from "../layout/Container.astro";

import { people } from "../../lib/people";

const alumni = people.filter(
  (person) => person.alumni
);
---

<Section class="people-section">

  <Container>

    <header class="section-header">

      <h2>Alumni</h2>

      <p>
        Former researchers and students who have contributed
        to the group's research programme.
      </p>

    </header>


    <div class="alumni-list">

      {
        alumni.map((person) => (

          <article class="alumni-entry">

            <div>

              <h3>{person.name}</h3>

              <p class="alumni-role">
                {person.role}
              </p>

            </div>


            <div class="alumni-details">

              {
                person.project && (
                  <p>
                    {person.project}
                  </p>
                )
              }

              {
                person.institution && (
                  <p class="alumni-institution">
                    {person.institution}
                  </p>
                )
              }

              {
                person.currentPosition && (
                  <p class="alumni-current">
                    {person.currentPosition}
                  </p>
                )
              }

            </div>

          </article>

        ))
      }

    </div>

  </Container>

</Section>