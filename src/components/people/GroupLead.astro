---
import Section from "../layout/Section.astro";
import Container from "../layout/Container.astro";

import { people } from "../../lib/people";

const lead = people.find(
  (person) => person.groupLead
);
---

<Section class="people-section">

  <Container>

    <header class="section-header">
      <h2>Group Lead</h2>
    </header>

    <article class="group-lead">

<div class="group-lead-photo">
  {lead?.photo && (
    <img
      src={lead.photo}
      alt={lead.name}
    />
  )}
</div>

      <div class="group-lead-content">

        <p class="person-role">
          Group Leader
        </p>

        <h3>Lida Kanari</h3>

        <p class="person-affiliation">
          University of Oxford
        </p>

        <p class="person-description">
          Mathematician and physicist working at the intersection of
          algebraic topology, computational modelling and neuroscience.
        </p>

        <a href="/people/lida-kanari" class="person-link">
          View CV →
        </a>

      </div>

    </article>

  </Container>

</Section>