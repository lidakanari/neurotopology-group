---
import Section from "../layout/Section.astro";
import Container from "../layout/Container.astro";
---

<Section class="people-section join-group">

  <Container>

    <div class="join-group-content">

      <div>

        <p class="join-group-label">
          Opportunities
        </p>

        <h2>Join the Group</h2>

      </div>

      <div class="join-group-text">

        <p>
          We welcome enquiries from researchers and students
          interested in mathematics, topology, computational
          neuroscience and neuronal morphology.
        </p>

        <p>
          Opportunities for doctoral research, postdoctoral
          projects and student research projects will be
          advertised here as they become available.
        </p>

        <a
          href="mailto:lida.kanari@maths.ox.ac.uk"
          class="join-group-link"
        >
          Get in touch →
        </a>

      </div>

    </div>

  </Container>

</Section>