---
import Section from "../layout/Section.astro";
import Container from "../layout/Container.astro";
---

<Section
  id="data-centric-computation"
  class="research-theme research-theme--computation"
>

  <Container>

    <!-- Theme introduction -->

    <header class="research-theme-header research-theme-header--visual">

      <div class="research-theme-header-figure">

        <img
          src="/images/research/data-centric-computation.png"
          alt="Computational representations and analysis of biological structure"
        />

      </div>


      <div class="research-theme-header-text">

        <h2>Data-Centric Computation</h2>

        <p>
          We develop computational approaches for learning from complex
          biological structure. Topological representations, graph-based
          methods and machine learning provide complementary ways to compare
          cells, identify morphological classes and integrate structural
          information with other biological modalities.
        </p>

      </div>

    </header>


    <!-- Projects + publications -->

    <div class="research-theme-grid">


      <!-- Projects -->

      <div class="research-theme-column">

        <h3 class="research-theme-label">
          Projects
        </h3>

        <div class="research-theme-list">

          <article class="research-theme-item">

            <h4>Learning Biological Structure</h4>

            <p>
              Topological and graph-based approaches for classification,
              representation learning and comparison of complex cellular
              morphologies.
            </p>

          </article>


          <article class="research-theme-item">

            <h4>Topological Morphology Descriptor</h4>

            <p>
              Quantitative representations for analysing and comparing
              branching morphologies across cell types, species and
              biological conditions.
            </p>

          </article>


          <article class="research-theme-item">

            <h4>Multimodal Cell Atlases</h4>

            <p>
              Integrating morphological information with transcriptomic,
              electrophysiological and spatial measurements to study
              cellular diversity.
            </p>

          </article>

        </div>

      </div>


      <!-- Publications -->

      <div class="research-theme-column">

        <h3 class="research-theme-label">
          Selected Publications
        </h3>

        <div class="research-publication-list">


          <!-- 2026 -->

          <a
            href="/publications#YOUR-MULTIMODAL-ATLAS-KEY"
            class="research-publication"
          >
            <span>2026</span>

            <p>
              A Multimodal Spatial Atlas of Transcriptomic,
              Morphological, and Electrophysiological Cell Type
              Densities in the Mouse Brain
            </p>
          </a>


          <!-- 2024 -->

          <a
            href="/publications#YOUR-GNN-KEY"
            class="research-publication"
          >
            <span>2024</span>

            <p>
              Deep Learning for Classifying Neuronal Morphologies:
              Combining Topological Data Analysis and Graph Neural Networks
            </p>
          </a>


          <!-- 2022 -->

          <a
            href="/publications#YOUR-MORPHOMICS-KEY"
            class="research-publication"
          >
            <span>2022</span>

            <p>
              A Tool for Mapping Microglial Morphology, morphOMICs,
              Reveals Brain-region and Sex-dependent Phenotypes
            </p>
          </a>


          <!-- 2019 -->

          <a
            href="/publications#YOUR-CLASSIFICATION-KEY"
            class="research-publication"
          >
            <span>2019</span>

            <p>
              Objective Morphological Classification of
              Neocortical Pyramidal Cells
            </p>
          </a>

        </div>

      </div>

    </div>


    <!-- Collaborations -->

    <div class="research-collaborations">

      <h3 class="research-theme-label">
        Collaborations
      </h3>

      <p>
        Henry Markram · Sandra Siegert · Daniel Keller · André Ferreira Castro
      </p>

    </div>

  </Container>

</Section>