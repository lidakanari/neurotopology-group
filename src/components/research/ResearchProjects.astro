---
import Section from "../layout/Section.astro";
import Container from "../layout/Container.astro";
---

<Section>

  <Container>

    <header class="section-header">

      <h2>Research Projects</h2>

      <p>
        Our research programme is organised around three complementary
        directions that connect mathematics with neuroscience.
      </p>

    </header>

    <div class="research-project-list">

      <article class="research-project">

        <div class="research-project-image">
          <!-- Figure -->
        </div>

        <div class="research-project-content">

          <span class="project-tag">
            Mathematical Foundations
          </span>

          <h3>Topology of Trees</h3>

          <p>

            Developing mathematical foundations for trees,
            branching structures and persistence barcodes.

          </p>

          <a href="/projects/topology-of-trees">

            Explore project →

          </a>

        </div>

      </article>

      <article class="research-project reverse">

        <div class="research-project-image">
          <!-- Figure -->
        </div>

        <div class="research-project-content">

          <span class="project-tag">
            Morphological Analysis
          </span>

          <h3>Topological Morphology Descriptor</h3>

          <p>

            Mathematical descriptors for quantifying neuronal
            morphology across scales and species.

          </p>

          <a href="/projects/topological-morphology-descriptor">

            Explore project →

          </a>

        </div>

      </article>

      <article class="research-project">

        <div class="research-project-image">
          <!-- Figure -->
        </div>

        <div class="research-project-content">

          <span class="project-tag">
            Brain Connectivity
          </span>

          <h3>From Neurons to Networks</h3>

          <p>

            Bridging neuronal morphology with
            brain-wide connectivity.

          </p>

          <a href="/projects/neurons-to-networks">

            Explore project →

          </a>

        </div>

      </article>

    </div>

  </Container>

</Section>