---
import Section from "../layout/Section.astro";
import Container from "../layout/Container.astro";
---

<Section
  id="mathematical-foundations"
  class="research-theme research-theme--mathematics"
>

  <Container>

    <!-- Theme introduction -->

    <header class="research-theme-header research-theme-header--visual">

      <div class="research-theme-header-figure">

        <img
          src="/images/research/mathematical-foundations.png"
          alt="Mathematical and topological representations of branching biological structures"
        />

      </div>


      <div class="research-theme-header-text">

        <h2>Mathematical Foundations</h2>

        <p>
          We develop mathematical representations and theoretical frameworks
          for complex biological structures. Using ideas from algebraic
          topology, topological data analysis and stochastic modelling,
          we study how branching systems can be represented, compared and
          reconstructed while preserving biologically meaningful information.
        </p>

      </div>

    </header>


    <!-- Projects + publications -->

    <div class="research-theme-grid">


      <!-- Projects -->

      <div class="research-theme-column">

        <h3 class="research-theme-label">
          Projects
        </h3>

        <div class="research-theme-list">

          <article class="research-theme-item">

            <h4>Topology of Trees</h4>

            <p>
              Mathematical representations of branching structures
              through persistence-based descriptors.
            </p>

          </article>


          <article class="research-theme-item">

            <h4>Topological Inverse Problems</h4>

            <p>
              Understanding which structural information can be
              recovered from topological summaries.
            </p>

          </article>


          <article class="research-theme-item">

            <h4>Temporal Topology</h4>

            <p>
              Extending topological representations to capture
              structural changes during neuronal development.
            </p>

          </article>

        </div>

      </div>


      <!-- Publications -->

      <div class="research-theme-column">

        <h3 class="research-theme-label">
          Selected Publications
        </h3>

        <div class="research-publication-list">


          <!-- 2026 -->

          <a
            href="/publications#rigaux2026temporal"
            class="research-publication"
          >
            <span>2026</span>

            <p>
              Temporal Topology Provides an Interpretable Framework
              for Neuronal Morphogenesis
            </p>
          </a>


          <!-- 2024 -->

          <a
            href="/publications#curry2024trees"
            class="research-publication"
          >
            <span>2024</span>

            <p>
              From Trees to Barcodes and Back Again II:
              Combinatorial and Probabilistic Aspects of a
              Topological Inverse Problem
            </p>
          </a>


          <!-- 2020 -->

          <a
            href="/publications#kanari2020trees"
            class="research-publication"
          >
            <span>2020</span>

            <p>
              From Trees to Barcodes and Back Again:
              Theoretical and Statistical Perspectives
            </p>
          </a>


          <!-- 2018 -->

          <a
            href="/publications#kanari2018topological"
            class="research-publication"
          >
            <span>2018</span>

            <p>
              A Topological Representation of Branching
              Neuronal Morphologies
            </p>
          </a>

        </div>

      </div>

    </div>


    <!-- Collaborations -->

    <div class="research-collaborations">

      <h3 class="research-theme-label">
        Collaborations
      </h3>

      <p>
        Kathryn Hess · Martina Scolamiero · Wojciech Chachólski
      </p>

    </div>

  </Container>

</Section>