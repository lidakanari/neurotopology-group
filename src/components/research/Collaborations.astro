---
import Section from "../layout/Section.astro";
import Container from "../layout/Container.astro";
---

<Section>

  <Container>

    <header class="section-header">

      <h2>Research Collaborations</h2>

      <p>
        NeuroTopology is built on interdisciplinary collaborations
        spanning mathematics, neuroscience, artificial intelligence
        and computational biology.
      </p>

    </header>

    <h3 class="collaboration-heading">
      Active Collaborations
    </h3>

    <div class="collaboration-grid">

      <article class="collaboration-card">

        <h4>Sandra Siegert Group</h4>

        <p class="collaboration-institution">
          IST Austria
        </p>

        <p class="collaboration-role">
          Microglia project
        </p>

	  <a
	    href="https://siegert-lab.pages.ist.ac.at/about-sandra/"
	    target="_blank"
	    rel="noopener noreferrer"
	  >
	    Visit research group →
	  </a>


      </article>

      <article class="collaboration-card">

        <h4>Hermann Cuntz</h4>

        <p class="collaboration-institution">
          Frankfurt
        </p>

        <p class="collaboration-role">
          Branching Dendrites & How to grow them
        </p>

	  <a
	    href="https://siegert-lab.pages.ist.ac.at/about-sandra/"
	    target="_blank"
	    rel="noopener noreferrer"
	  >
	    Visit research group →
	  </a>

      </article>

      <article class="collaboration-card">

        <h4>Marco Palombo Group</h4>

        <p class="collaboration-institution">
          Cardiff
        </p>

        <p class="collaboration-role">
          Topological Synthesis for MRI
        </p>

	  <a
	    href="https://profiles.cardiff.ac.uk/staff/palombom"
	    target="_blank"
	    rel="noopener noreferrer"
	  >
	    Visit research group →
	  </a>


      </article>

      <article class="collaboration-card">

        <h4>Open Brain Institute</h4>

        <p class="collaboration-institution">
          Lausanne
        </p>

        <p class="collaboration-role">
          Computational Neuroscience Labs
        </p>

	  <a
	    href="https://www.openbraininstitute.org/"
	    target="_blank"
	    rel="noopener noreferrer"
	  >
	    Visit research group →
	  </a>


      </article>

    </div>

    <h3 class="collaboration-heading">
      Previous Collaborations
    </h3>

    <div class="collaboration-grid">

      <article class="collaboration-card">

        <h4>Blue Brain Project</h4>

        <p class="collaboration-institution">
          EPFL
        </p>

        <p class="collaboration-role">
          Neuronal morphology and connectomics
        </p>

        <a href="#">
          Visit project →
        </a>

      </article>

      <article class="collaboration-card">

        <h4>LNMC</h4>

        <p class="collaboration-institution">
          EPFL
        </p>

        <p class="collaboration-role">
          Neuronal morphology reconstructions
        </p>

        <a href="#">
          Visit project →
        </a>

      </article>

    </div>

  </Container>

</Section>