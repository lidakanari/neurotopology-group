---
import Section from "../layout/Section.astro";
import Container from "../layout/Container.astro";

import { sitePath } from "../../lib/paths";
---

<Section
  id="from-cells-to-systems"
  class="research-theme research-theme--systems"
>

  <Container>

    <!-- Theme introduction -->

    <header class="research-theme-header research-theme-header--visual">

      <div class="research-theme-header-figure">

        <img
          src={sitePath("/images/research/cells-to-systems.png")}
          alt="Relationship between cellular morphology and larger-scale biological organization"
        />

      </div>


      <div class="research-theme-header-text">

        <h2>From Cells to Systems</h2>

        <p>
          We investigate how properties of individual cells propagate
          across biological scales. Our work asks how neuronal morphology
          shapes connectivity, how cellular diversity influences network
          architecture, and how local structural principles contribute to
          the organization of tissues and complex brain systems.
        </p>

      </div>

    </header>


    <!-- Projects + publications -->

    <div class="research-theme-grid">


      <!-- Projects -->

      <div class="research-theme-column">

        <h3 class="research-theme-label">
          Projects
        </h3>

        <div class="research-theme-list">

          <article class="research-theme-item">

            <h4>From Neurons to Networks</h4>

            <p>
              Linking single-neuron morphology to network-scale
              connectivity and investigating how cellular structure
              contributes to brain-network organization.
            </p>

          </article>


          <article class="research-theme-item">

            <h4>Comparative Neuronal Architecture</h4>

            <p>
              Understanding structural differences across species
              and investigating their consequences for neuronal
              and network organization.
            </p>

          </article>


          <article class="research-theme-item">

            <h4>Connectome Generation</h4>

            <p>
              Constructing brain-wide connectivity from synthetic
              axonal morphologies to investigate relationships
              between neuronal form and network structure.
            </p>

          </article>


          <article class="research-theme-item">

            <h4>Tissue Organisation</h4>

            <p>
              Investigating how cellular structure and spatial
              constraints contribute to organization at tissue
              and system scales.
            </p>

          </article>

        </div>

      </div>


      <!-- Publications -->

      <div class="research-theme-column">

        <h3 class="research-theme-label">
          Selected Publications
        </h3>

        <div class="research-publication-list">


          <!-- 2026 -->

          <a
            href={sitePath("/publications#reimann2026spatial")}
            class="research-publication"
          >
            <span>2026</span>

            <p>
              Spatial Continuity of Neurons Explains
              Non-random Network Architecture
            </p>
          </a>


          <a
            href={sitePath("/publications#barroszulaica2026connectome")}
            class="research-publication"
          >
            <span>2026</span>

            <p>
              Uncovering the Basis of Human Connectome Complexity:
              The Role of Neuronal Morphology
            </p>
          </a>


          <a
            href={sitePath("/publications#siegert2026selforganized")}
            class="research-publication"
          >
            <span>2026</span>

            <p>
              Self-organized Tiling Generates Tissue-scale
              Hyperuniformity During Development
            </p>
          </a>


          <!-- 2025 -->

          <a
            href={sitePath("/publications#kanari2025mice")}
            class="research-publication"
          >
            <span>2025</span>

            <p>
              Of Mice and Men: Dendritic Architecture
              Differentiates Human from Mouse Neuronal Networks
            </p>
          </a>


          <a
            href={sitePath("/publications#petkantchin2025connectome")}
            class="research-publication"
          >
            <span>2025</span>

            <p>
              Generating Brain-wide Connectome Using
              Synthetic Axonal Morphologies
            </p>
          </a>

        </div>

      </div>

    </div>


    <!-- Collaborations -->

    <div class="research-collaborations">

      <h3 class="research-theme-label">
        Collaborations
      </h3>

      <p>
        Michael Reimann · Natalí Barros-Zulaica · Mehmet Uçar ·
        Daniela Egas Santander · Idan Segev
      </p>

    </div>

  </Container>

</Section>