---
import Section from "../layout/Section.astro";
import Container from "../layout/Container.astro";
---

<Section
  id="generative-biology"
  class="research-theme research-theme--generative"
>

  <Container>

    <!-- Theme introduction -->

    <header class="research-theme-header research-theme-header--visual">

      <div class="research-theme-header-figure">

        <img
          src="/images/research/generative-biology.jpg"
          alt="Computational generation of realistic biological morphologies"
        />

      </div>


      <div class="research-theme-header-text">

        <h2>Generative Biology</h2>

        <p>
          We use mathematical and computational models to investigate
          how complex biological structures are generated. By combining
          statistical descriptions, biological constraints and generative
          algorithms, we construct realistic cellular morphologies and use
          synthesis as a tool for testing hypotheses about biological
          structure and variability.
        </p>

      </div>

    </header>


    <!-- Projects + publications -->

    <div class="research-theme-grid">


      <!-- Projects -->

      <div class="research-theme-column">

        <h3 class="research-theme-label">
          Projects
        </h3>

        <div class="research-theme-list">

          <article class="research-theme-item">

            <h4>Dendritic Synthesis</h4>

            <p>
              Computational generation of realistic dendritic
              morphologies from statistical, topological and
              biological constraints.
            </p>

          </article>


          <article class="research-theme-item">

            <h4>Axon Synthesis</h4>

            <p>
              Generative modelling of long-range axonal morphologies
              and their projection patterns across brain regions.
            </p>

          </article>


          <article class="research-theme-item">

            <h4>Contextual Cellular Growth</h4>

            <p>
              Generating cellular structures within realistic tissue
              environments to investigate morphology in its spatial
              and biological context.
            </p>

          </article>


          <article class="research-theme-item">

            <h4>Structure–Function Constraints</h4>

            <p>
              Investigating how neuronal morphology and
              electrophysiological properties constrain one another.
            </p>

          </article>

        </div>

      </div>


      <!-- Publications -->

      <div class="research-theme-column">

        <h3 class="research-theme-label">
          Selected Publications
        </h3>

        <div class="research-publication-list">


          <!-- 2026 -->

          <a
            href="/publications#airdrossiter2026contextual"
            class="research-publication"
          >
            <span>2026</span>

            <p>
              Contextual Cellular Growth (ConCeG) of Neural Cells
              for Realistic Grey Matter Tissue Generation for
              Diffusion MRI Simulations
            </p>
          </a>


          <!-- 2025 -->

          <a
            href="/publications#berchet2025axonal"
            class="research-publication"
          >
            <span>2025</span>

            <p>
              Computational Generation of Long-range
              Axonal Morphologies
            </p>
          </a>


          <a
            href="/publications#petkantchin2025connectome"
            class="research-publication"
          >
            <span>2025</span>

            <p>
              Generating Brain-wide Connectome Using
              Synthetic Axonal Morphologies
            </p>
          </a>


          <!-- 2023 -->

          <a
            href="/publications#arnaudon2023controlling"
            class="research-publication"
          >
            <span>2023</span>

            <p>
              Controlling Morpho-electrophysiological Variability
              of Neurons with Detailed Biophysical Models
            </p>
          </a>


          <!-- 2022 -->

          <a
            href="/publications#kanari2022computational"
            class="research-publication"
          >
            <span>2022</span>

            <p>
              Computational Synthesis of Cortical
              Dendritic Morphologies
            </p>
          </a>

        </div>

      </div>

    </div>


    <!-- Collaborations -->

    <div class="research-collaborations">

      <h3 class="research-theme-label">
        Collaborations
      </h3>

      <p>
        Marco Palombo · Hermann Cuntz · Alexis Arnaudon · Adrien Berchet · Remy Petkantchin
      </p>

    </div>

  </Container>

</Section>