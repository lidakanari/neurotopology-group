---
import MainLayout from "../layouts/MainLayout.astro";

import Navigation from "../components/navigation/Navigation.astro";
import Footer from "../components/layout/Footer.astro";

import DataHero from "../components/data/DatasetHero.astro";
import DatasetEntry from "../components/data/DatasetEntry.astro";

import Section from "../components/layout/Section.astro";
import Container from "../components/layout/Container.astro";

import { datasets } from "../lib/datasets";


const sortedDatasets = [...datasets].sort(
  (a, b) => b.year - a.year
);
---

<MainLayout
  title="Research Data"
  description="Open research datasets supporting work in neuronal morphology, topology and computational neuroscience."
>

  <Navigation />

  <main>

    <DataHero />


    <Section class="dataset-section">

      <Container>

        <header class="section-header">

          <h2>Research Datasets</h2>

        </header>


        <div class="dataset-list">

          {
            sortedDatasets.map((dataset) => (

              <DatasetEntry
                dataset={dataset}
              />

            ))
          }

        </div>

      </Container>

    </Section>

  </main>

  <Footer />

</MainLayout>