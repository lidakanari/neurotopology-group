
---
import MainLayout from "../layouts/MainLayout.astro";

import Navigation from "../components/navigation/Navigation.astro";
import Footer from "../components/layout/Footer.astro";
import Container from "../components/layout/Container.astro";

import { sitePath } from "../lib/paths";

// Images and game URLs
const hero = sitePath(
  "/interactive/assets/neuron-brewer-hero.webp"
);

const neuronPlayUrl = sitePath("/interactive/play/neuron/");
const fractalPlayUrl = sitePath("/interactive/play/fractal/");
---

<MainLayout title="Neuron Brewer — NeuroTopology">

  <Navigation />

  <main>

    <section class="brewer-hero">

      <Container>

        <div class="brewer-content">

          <p class="brewer-eyebrow">
            Interactive Neuroscience
          </p>

          <h1>Neuron Brewer</h1>

          <p class="brewer-tagline">
            Grow your neuron!
          </p>


          <!-- Game illustration -->

          <img
            class="brewer-art"
            src={hero}
            alt="Colourful branching neuronal tree representing the Neuron Brewer game"
            width="1536"
            height="1024"
            fetchpriority="high"
          />


          <!-- Introduction -->

          <p class="brewer-intro">
            Discover how neurons grow like trees,
            branch to explore their environment,
            and compete for resources.

            Build a neuronal tree, then explore
            its morphological features, wiring
            efficiency, and topology.
          </p>


          <!-- Compact mode picker and one shared Play button -->
          <div class="brewer-launcher">
            <fieldset class="brewer-modes">
              <legend>Choose your growth mode</legend>
              <div class="brewer-mode-picker">
                <label class="brewer-mode-choice">
                  <input
                    type="radio"
                    name="brewer-mode"
                    value="neuron"
                    checked
                  />
                  <span>Neuron</span>
                </label>
                <label class="brewer-mode-choice">
                  <input
                    type="radio"
                    name="brewer-mode"
                    value="fractal"
                  />
                  <span>Fractal</span>
                </label>
              </div>
            </fieldset>

            <p id="brewer-mode-help" class="brewer-mode-help" aria-live="polite">
              Guide a growing neuron and choose when to branch.
            </p>

            <a
              class="brewer-play"
              id="brewer-play"
              href={neuronPlayUrl}
              data-neuron-url={neuronPlayUrl}
              data-fractal-url={fractalPlayUrl}
            >
              Play Neuron Brewer →
            </a>
          </div>

        </div>

      </Container>

    </section>

  </main>

  <Footer />

</MainLayout>


<script>
  const play = document.querySelector<HTMLAnchorElement>("#brewer-play");
  const help = document.querySelector<HTMLElement>("#brewer-mode-help");
  const radios = document.querySelectorAll<HTMLInputElement>(
    'input[name="brewer-mode"]'
  );

  function selectMode(mode: "neuron" | "fractal") {
    radios.forEach((radio) => {
      radio.checked = radio.value === mode;
    });

    if (play) {
      play.href = mode === "fractal"
        ? play.dataset.fractalUrl!
        : play.dataset.neuronUrl!;
    }

    if (help) {
      help.textContent = mode === "fractal"
        ? "Set branching rules and watch a fractal tree grow."
        : "Guide a growing neuron and choose when to branch.";
    }
  }

  radios.forEach((radio) => {
    radio.addEventListener("change", () => {
      if (radio.checked) selectMode(radio.value as "neuron" | "fractal");
    });
  });

  // Returning from a game remembers which mode was open.
  const requestedMode = new URLSearchParams(window.location.search).get("mode");
  selectMode(requestedMode === "fractal" ? "fractal" : "neuron");
</script>


<style>

  .brewer-hero {
    padding: clamp(2rem, 5vw, 4.5rem) 0;

    background:
      radial-gradient(
        ellipse at 50% 48%,
        #0e302e 0%,
        #071522 60%,
        #050c15 100%
      );

    color: #eaf8f8;
  }


  .brewer-content {
    max-width: 1020px;
    margin-inline: auto;
    text-align: center;
  }


  .brewer-eyebrow {
    color: #88dfcd;
    font-size: .82rem;
    letter-spacing: .14em;
    text-transform: uppercase;
    font-weight: 700;
    margin: 0 0 .6rem;
  }


  .brewer-content h1 {
    font-size: clamp(2.8rem, 6vw, 4.5rem);
    line-height: 1.1;
    margin: 0;
    color: #f1fbff;
  }


  .brewer-tagline {
    font-size: clamp(1.15rem, 2.4vw, 1.55rem);
    color: #a0e8dd;
    margin: .35rem 0 1.4rem;
  }


  .brewer-art {
    width: 100%;
    height: auto;
    display: block;

    border: 1px solid #31545c;
    border-radius: 20px;

    box-shadow: 0 24px 55px #0008;
  }


  .brewer-intro {
    max-width: 740px;
    margin: 1.6rem auto;

    font-size: 1.08rem;
    line-height: 1.75;
    color: #c4d9e2;
  }


  /* Compact, accessible two-mode switch. */
  .brewer-launcher {
    max-width: 740px;
    margin: 1.7rem auto 0;
  }

  .brewer-modes {
    margin: 0;
    padding: 0;
    border: 0;
  }

  .brewer-modes legend {
    color: #91e0d2;
    font-size: .8rem;
    font-weight: 700;
    letter-spacing: .12em;
    text-transform: uppercase;
    text-align: center;
    width: 100%;
    padding: 0;
    margin-bottom: .65rem;
  }

  .brewer-mode-picker {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 5px;
    max-width: 380px;
    margin: 0 auto;
    padding: 5px;
    background: #0a2030;
    border: 1px solid #395d68;
    border-radius: 13px;
  }

  .brewer-mode-choice {
    position: relative;
    display: block;
    cursor: pointer;
  }

  .brewer-mode-choice input {
    position: absolute;
    width: 1px;
    height: 1px;
    opacity: 0;
  }

  .brewer-mode-choice span {
    display: block;
    padding: .7rem 1rem;
    border-radius: 9px;
    color: #c5d9e4;
    font-weight: 700;
    text-align: center;
    transition: background .15s, color .15s;
  }

  .brewer-mode-choice input:checked + span {
    color: #effbfc;
    background: #20534f;
    box-shadow: inset 0 0 0 1px #8ae7d2;
  }

  .brewer-mode-choice input:focus-visible + span {
    outline: 3px solid #fff;
    outline-offset: 2px;
  }

  .brewer-mode-help {
    margin: .9rem auto 1.15rem;
    min-height: 1.5em;
    color: #c4d9e2;
    font-size: .95rem;
  }

  .brewer-play {
    display: block;
    max-width: 740px;

    margin: 0 auto;
    padding: 1.1rem 1.4rem;

    border-radius: 13px;

    background:
      linear-gradient(
        105deg,
        #a0f0d9,
        #71d8cc
      );

    color: #062821;

    font-size: clamp(1.05rem, 2.4vw, 1.35rem);
    font-weight: 800;

    text-decoration: none;

    box-shadow: 0 12px 30px #16a68d33;
  }


  .brewer-play:hover {
    filter: brightness(1.08);
  }


  /* Mobile */

  @media (max-width: 640px) {

    .brewer-art {
      border-radius: 12px;
    }

  }

</style>
