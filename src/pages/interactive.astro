---
import MainLayout from "../layouts/MainLayout.astro";
import Navigation from "../components/navigation/Navigation.astro";
import Footer from "../components/layout/Footer.astro";
import Container from "../components/layout/Container.astro";
---

<MainLayout title="Interactive">

  <Navigation />

  <main>

    <section class="interactive-coming-soon">

      <Container>

        <div class="interactive-coming-soon-content">

          <p class="interactive-label">
            Interactive
          </p>

          <h1>
            Explore neuronal structure.
          </h1>

          <p class="interactive-intro">
            Interactive tools for exploring neuronal morphology,
            topology and structure are currently in development.
          </p>

          <div class="interactive-status">
            Coming soon
          </div>

        </div>

      </Container>

    </section>

  </main>

  <Footer />

</MainLayout>