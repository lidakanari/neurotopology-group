---
import MainLayout from "../layouts/MainLayout.astro";

import Navigation from "../components/navigation/Navigation.astro";
import Footer from "../components/layout/Footer.astro";
import Container from "../components/layout/Container.astro";
---

<MainLayout
  title="Page Not Found"
  description="The requested page could not be found on the NeuroTopology website."
>

  <Navigation />

  <main>

    <section class="not-found">

      <Container>

        <div class="not-found-content">

          <p class="not-found-code">
            404
          </p>

          <h1>
            Page not found
          </h1>

          <p class="not-found-text">
            The page you are looking for may have moved,
            changed address, or no longer exists.
          </p>

          <div class="not-found-links">

            <a
              href="/"
              class="not-found-primary"
            >
              Return home →
            </a>

            <a
              href="/research"
              class="not-found-secondary"
            >
              Explore our research
            </a>

          </div>

        </div>

      </Container>

    </section>

  </main>

  <Footer />

</MainLayout>