---
import MainLayout from "../layouts/MainLayout.astro";

import Navigation from "../components/navigation/Navigation.astro";
import Footer from "../components/layout/Footer.astro";

import SoftwareHero from "../components/software/SoftwareHero.astro";
import SoftwareTool from "../components/software/SoftwareTool.astro";

import Section from "../components/layout/Section.astro";
import Container from "../components/layout/Container.astro";

import { software } from "../lib/software";
---

<MainLayout
  title="Scientific Software"
  description="Open-source scientific software for topological analysis, neuronal morphology, classification and computational synthesis."
>

  <Navigation />

  <main>

    <SoftwareHero />


    <Section class="software-section">

      <Container>

        <header class="section-header">

          <h2>Scientific Software</h2>

        </header>


        <div class="software-list">

          {
            software.map((tool) => (

              <SoftwareTool
                tool={tool}
              />

            ))
          }

        </div>

      </Container>

    </Section>

  </main>

  <Footer />

</MainLayout>